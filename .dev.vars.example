# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
GITHUB_CLIENT_ID=<github oauth app client id (callback http://localhost:8788/callback)>
GITHUB_CLIENT_SECRET=<github oauth app client secret>
COOKIE_ENCRYPTION_KEY=<openssl rand -hex 32>
UNIFI_API_KEY=<unifi os api key from a View-Only admin>
ALLOWED_GITHUB_USERS=<your-github-login>
# Only for the public-hostname + Cloudflare Access mode:
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
