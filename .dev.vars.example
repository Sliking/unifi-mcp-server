# Secrets. The "Deploy to Cloudflare" button prompts for each of these.
# For local development, copy to .dev.vars (never commit .dev.vars).

# Site Manager API key (cloud mode, unifi.ui.com -> API) or local UniFi OS API key (local mode)
UNIFI_API_KEY=
# GitHub OAuth app, callback https://<worker-url>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random 32+ byte hex string: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=
